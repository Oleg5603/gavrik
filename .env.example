TELEGRAM_TOKEN=your_telegram_bot_token
# Заполнять только если api.telegram.org недоступен напрямую с сервера
TELEGRAM_PROXY_URL=
VK_TOKEN=your_vk_token
VK_GROUP_ID=227082800
SITE_URL=https://palkina-therapy.ru
ALLOWED_USER_IDS=123456789,987654321

# VPS агент (опционально — если не задан, claude запускается локально)
VPS_HOST=
VPS_USER=root
VPS_PASSWORD=
CLAUDE_BIN=claude
AGENT_PROVIDER=codex
CODEX_BIN=codex

# Anthropic API (рекомендуется — быстро и надёжно, без subprocess)
# Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Расшифровка голосовых сообщений (см. media.py). Без ключа голосовые
# принимаются, но бот честно скажет что расшифровка не настроена.
# Получить бесплатно: https://console.deepgram.com/api-keys ($200 кредитов)
DEEPGRAM_API_KEY=

# Agent Ledovskikh: Telegram user API credentials from https://my.telegram.org
LEDOVSKIKH_TG_API_ID=
LEDOVSKIKH_TG_API_HASH=
LEDOVSKIKH_TG_SESSION=.private/ledovskikh
LEDOVSKIKH_TG_FOLDER=Нейрозавод
# Optional reliable alternative to the folder: comma-separated chat IDs
LEDOVSKIKH_TG_CHAT_IDS=
